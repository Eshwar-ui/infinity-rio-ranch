# Copy to .env.local and fill in real values. .env.local is gitignored.
# NEVER commit real credentials to this file — it is tracked in git.

# Public Vite variables (inlined into the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only Google Business Profile OAuth configuration.
# Never prefix credentials or tokens with VITE_.
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN=your-offline-refresh-token
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=your-business-profile-account-id
GOOGLE_BUSINESS_PROFILE_LOCATION_ID=your-location-id
Business_management_API_KEY=your-business-management-api-key
