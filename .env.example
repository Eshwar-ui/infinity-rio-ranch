# Public Vite variables (inlined into the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only Google Business Profile OAuth configuration.
# Never prefix credentials or tokens with VITE_.
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=REDACTED
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=REDACTED
GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN=REDACTED
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=REDACTED
GOOGLE_BUSINESS_PROFILE_LOCATION_ID=REDACTED
Business_management_API_KEY=REDACTED