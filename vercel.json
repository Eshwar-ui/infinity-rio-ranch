{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },

    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },

    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/invoice/(.*)", "destination": "/index.html" },

    {
      "source": "/agreement/:token",
      "destination": "https://xmnneacpgjwaihwcvayx.supabase.co/functions/v1/public-agreement?token=:token"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/build/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "//": "One rule for everything under /assets, fonts included. 30 days rather than a year immutable because `npm run optimize:images` re-encodes photos *in place* under the same filename — a year would freeze a replaced photo in returning browsers. Fonts could safely take the year (a webfont is replaced by renaming it), but they cannot have a rule of their own: a second entry matching /assets/fonts/* is ignored whether it is ordered before or after this one, and a negative lookahead in the source (`/assets/((?!fonts/).*)`) still matches font paths. Both were tried and checked against a cache-MISS response from the deployment, not against the docs. Moving the fonts to a top-level /fonts/ would work, and is not worth the churn for 63 kB.",
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/invoice/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/agreement/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ]
}
