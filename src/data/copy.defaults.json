  { "key": "about.hero.title", "page": "about", "label": "Hero · title", "type": "text", "sort": 1, "value": "About Us" },
  { "key": "about.intro.eyebrow", "page": "about", "label": "Intro · eyebrow", "type": "text", "sort": 10, "value": "Welcome to Infinity" },
  { "key": "about.intro.title", "page": "about", "label": "Intro · heading", "type": "multiline", "sort": 11, "value": "Two acres of timeless charm and modern amenities." },
  { "key": "about.intro.body1", "page": "about", "label": "Intro · first paragraph", "type": "multiline", "sort": 12, "value": "Infinity at Rio Ranch is a wedding and event venue in Liberty Hill, Texas, in the Greater Austin area. It spreads across two acres, featuring 2,600 sq ft of indoor space and 12,400 sq ft of outdoor space — perfect for hosting unforgettable celebrations. Whether you're planning an intimate gathering or a grand celebration, our venue offers the perfect blend of sophistication and natural beauty." },
  { "key": "about.intro.body2", "page": "about", "label": "Intro · second paragraph", "type": "multiline", "sort": 13, "value": "Combining rustic elegance with contemporary comfort, Infinity is designed to be the backdrop for your most meaningful moments — and the stunning photographs you'll treasure long after." },
  { "key": "about.intro.cta", "page": "about", "label": "Intro · button", "type": "text", "sort": 14, "value": "Schedule a Tour" },
  { "key": "about.glance.title", "page": "about", "label": "Venue at a glance · heading", "type": "text", "sort": 20, "value": "The venue at a glance" },
  { "key": "about.amenities.eyebrow", "page": "about", "label": "Amenities · eyebrow", "type": "text", "sort": 30, "value": "Owners & amenities" },
  { "key": "about.amenities.title", "page": "about", "label": "Amenities · heading", "type": "multiline", "sort": 31, "value": "Family-owned, personally hosted." },
  { "key": "about.amenities.body", "page": "about", "label": "Amenities · paragraph", "type": "multiline", "sort": 32, "value": "Infinity Weddings & Events pairs attentive, personal service with thoughtfully appointed spaces — so every detail of your celebration feels effortless from your first tour to your final dance." },
  { "key": "about.included.eyebrow", "page": "about", "label": "What's included · eyebrow", "type": "text", "sort": 40, "value": "Effortless from the start" },
