  { "key": "home.band.body", "page": "home", "label": "Photo band · paragraph", "type": "multiline", "sort": 32, "value": "Spanning two acres with stunning indoor and outdoor spaces, Infinity at Rio Ranch is designed for unforgettable weddings, celebrations, corporate events, and community gatherings — elegance, versatility, and natural beauty all in one place." },
